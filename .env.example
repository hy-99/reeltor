# Secrets
DATABASE_URL=
OPENAI_API_KEY=

# Worker
POLL_INTERVAL_MS=10000
BATCH_SIZE=5
MAX_RETRIES=3
TEMP_DIR=./tmp
LOG_LEVEL=info
ENABLE_MOCK_FETCH=false
DEBUG_KEEP_TEMP_FILES=false
WORKER_NAME=reeltor-worker

# Runtime tools
REQUEST_TIMEOUT_MS=30000
FRAME_INTERVAL_SECONDS=1.5
MAX_FRAMES=8
NORMALIZED_VIDEO_WIDTH=720
NORMALIZED_VIDEO_HEIGHT=1280
YT_DLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=

# OpenAI models
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_STRUCTURED_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local test mode
LOCAL_TEST_FIXTURE=fixtures/local-test-record.json
